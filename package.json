{
  "name": "sonsa-browser",
  "version": "0.1.0",
  "description": "Prototype de navigateur SONSA et serveur admin de collecte IP/MAC",
  "main": "main.js",
  "scripts": {
    "start": "node ./server/index.js",
    "electron": "electron .",
    "server": "node ./server/index.js",
    "dev:server": "node ./server/index.js",
    "deploy": "npm install && node ./server/index.js",
    "prepare": "electron-builder install-app-deps",
    "package:win": "npx electron-packager . SONSA --platform=win32 --arch=x64 --out=dist --overwrite --asar --prune=true",
    "build:installer": "node ./build-installer.js",
    "dist": "electron-builder --win portable --x64",
    "dist:nsis": "electron-builder --win nsis --x64",
    "build:all": "npm install && npm run dist:nsis",
    "build:installer:custom": "npm install && npm run package:win && node ./create-installer.js",
    "install:app": "powershell -Command \"Start-Process powershell -ArgumentList '-NoExit', '-Command', 'cscript.exe dist\\install.vbs' -Verb RunAs\""
  },
  "build": {
    "appId": "com.sonsa.browser",
    "productName": "SONSA Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!tmp-pack-test",
      "!tmp-pack-test-output",
      "!buildlog.txt"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false
    }
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^26.6.10",
    "electron-builder": "^26.8.1",
    "electron-packager": "^16.0.0",
    "electron-winstaller": "^5.4.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.6.3"
  }
}
